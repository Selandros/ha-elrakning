{
  "manifest_version": 3,
  "name": "Elräkning – Mitt E.ON-handoff",
  "version": "1.0.1",
  "description": "Completes the one-time authenticated Mitt E.ON handoff to Home Assistant.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.eon.se/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "service_worker.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://www.eon.se/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html"
}
